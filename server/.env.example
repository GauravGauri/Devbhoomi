# Server Port (Render sets this automatically, but required for local)
PORT=5000

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.iyjglma.mongodb.net/?appName=Cluster0

# JWT Auth Secrets (generate strong random keys in production)
JWT_SECRET=devbhoomi_super_secret_jwt_key_change_in_production
JWT_REFRESH_SECRET=devbhoomi_super_secret_jwt_refresh_key_change_in_production

# Set to "production" on Render so cookies use SameSite=None and Secure=true
NODE_ENV=production

# Frontend Vercel URL
CLIENT_URL=https://your-devbhoomi-app.vercel.app

# Allowed CORS Origins (comma-separated, no trailing slashes)
ALLOWED_ORIGINS=https://your-devbhoomi-app.vercel.app,http://localhost:5173

# Optional: Office Public IP for attendance network restriction
OFFICE_PUBLIC_IP=127.0.0.1
